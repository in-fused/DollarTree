# Required by the Vercel API functions. Never expose the service-role key in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin used when generating invite and share URLs.
PUBLIC_APP_URL=

# Optional email invite delivery.
RESEND_API_KEY=
INVITE_EMAIL_FROM=

# Optional SMS invite delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional override for the local geocoding utility.
MAPBOX_TOKEN=
